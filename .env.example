# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Recipient Email (where you want to receive portfolio inquiries)
EMAIL_RECEIVER="your-email@gmail.com"

# Verified Sender Email (use onboarding@resend.dev during testing or your verified custom domain)
VERIFIED_SENDER_EMAIL="onboarding@resend.dev"

# Cloudflare Turnstile Keys (from Cloudflare Dashboard -> Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAxxxxxxxx"
TURNSTILE_SECRET_KEY="0x4AAAAAAxxxxxxxx"
